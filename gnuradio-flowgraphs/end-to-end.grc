- name: resumen_ensayo
  id: snippet
  parameters:
    alias: ''
    code: 'n_tx = self.debug_trama_tx.num_messages()

      n_normal = len(self.debug_deteccion.current_tags())

      n_invertida = len(self.debug_invertida.current_tags())

      n_det = n_normal + n_invertida

      n_rx = self.debug_paquete_rx.num_messages()

      n_ok = self.blocks_message_debug_0.num_messages()

      print(f"RESUMEN amplitud={self.ruido_amplitud} semilla={self.ruido_semilla}",
      flush=True)

      print(f"TX={n_tx} DET={n_det} RX={n_rx} OK={n_ok}", flush=True)

      print(f"RECH={n_rx-n_ok} SIN_PDU={n_tx-n_rx} SIN_TEXTO={n_tx-n_ok}", flush=True)

      print("TEXTOS_OK=", [pmt.symbol_to_string(self.blocks_message_debug_0.get_message(i))
      for i in range(n_ok)], flush=True)

      print(f"FASE grados={self.fase_grados} costas={''activo'' if hasattr(self, ''recuperar_fase'')
      else ''sin_lazo''}", flush=True)

      print(f"POLARIDAD normal={n_normal} invertida={n_invertida}", flush=True)

      print(f"FRECUENCIA offset_hz={self.frecuencia_offset_hz}", flush=True)

      print(f"TIEMPO retardo_muestras={self.retardo_muestras} offset_muestreo={self.offset_muestreo}",
      flush=True)

      print(f"RELOJ ppm={self.reloj_ppm} temporal={''activo'' if hasattr(self, ''sincronizar_simbolos'')
      else ''fijo''}", flush=True)'
    comment: ''
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 24.0]
    rotation: 0
    state: enabled
