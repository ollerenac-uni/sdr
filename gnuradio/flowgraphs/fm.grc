- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.decim_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Convierte bytes I/Q\
      \ intercalados a muestras complejas\"\"\"\n\n    def __init__(self):  # only\
      \ default arguments here\n        \"\"\"arguments to this function show up as\
      \ parameters in GRC\"\"\"\n        gr.decim_block.__init__(\n            self,\n\
      \            name='Conversor de .cu8 a .c64',   # will show up in GRC\n    \
      \        in_sig=[np.uint8],\n            out_sig=[np.complex64],\n         \
      \   decim=2\n        )\n        # if an attribute with the same name as a parameter\
      \ is found,\n        # a callback is registered (properties work, too).\n  \
      \      # self.example_param = example_param\n\n    def work(self, input_items,\
      \ output_items):\n        # espacio dispnible para muestras complejas\n    \
      \    n = len(output_items[0])\n\n        # dos bytes de entrada por cada complejo\
      \ de salida\n        datos = input_items[0][:n*2]\n\n        # se separan los\
      \ bytes I y Q\n        i = datos[::2].astype(np.float32)\n        q = datos[1::2].astype(np.float32)\n\
      \n        # centrar y normalizar cada componente\n        i = i / 127.5 - 1.0\n\
      \        q = q / 127.5 - 1.0\n\n        # construir la muestra compleja\n  \
      \      output_items[0][:] = i + 1j * q\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Conversor de .cu8 a .c64', 'blk', [], [('0', 'byte', 1)], [('0',
      'complex', 1)], 'Convierte bytes I/Q intercalados a muestras complejas', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 304.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Desplaza el espectro mediante una exponencial compleja.\"\"\"\n\n\
      \    def __init__(self, frecuencia_mezcla=0.0, samp_rate=2.4e6):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Rotador de frecuencia',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n\n        self.frecuencia_mezcla\
      \ = float(frecuencia_mezcla)\n        self.samp_rate = float(samp_rate)\n\n\
      \        # Fase que corresponde a la pr\xF3xima muestra.\n        self.fase\
      \ = 0.0\n\n    def work(self, input_items, output_items):\n        n = len(output_items[0])\n\
      \n        # Radianes que avanza el oscilador por muestra.\n        incremento\
      \ = (\n            2 * np.pi * self.frecuencia_mezcla / self.samp_rate\n   \
      \     )\n\n        # Fases de las n muestras de este lote.\n        indices\
      \ = np.arange(n, dtype=np.float64)\n        fases = self.fase + incremento *\
      \ indices\n\n        # Exponencial compleja y multiplicaci\xF3n de las muestras.\n\
      \        oscilador = np.exp(1j * fases)\n        output_items[0][:n] = input_items[0][:n]\
      \ * oscilador\n\n        # Conservar la fase de la siguiente muestra.\n    \
      \    self.fase = (self.fase + incremento * n) % (2 * np.pi)\n\n        return\
      \ n"
    affinity: ''
    alias: ''
    comment: ''
    frecuencia_mezcla: 99.1*1e6 - freq_sint*M
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: ('Rotador de frecuencia', 'blk', [('frecuencia_mezcla', '0.0'), ('samp_rate',
      '2400000.0')], [('0', 'complex', 1)], [('0', 'complex', 1)], 'Desplaza el espectro
      mediante una exponencial compleja.', ['frecuencia_mezcla', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 408.0]
    rotation: 0
    state: enabled
- name: epy_block_1_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Desplaza el espectro mediante una exponencial compleja.\"\"\"\n\n\
      \    def __init__(self, frecuencia_mezcla=0.0, samp_rate=2.4e6):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Rotador de frecuencia',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n\n        self.frecuencia_mezcla\
      \ = float(frecuencia_mezcla)\n        self.samp_rate = float(samp_rate)\n\n\
      \        # Fase que corresponde a la pr\xF3xima muestra.\n        self.fase\
      \ = 0.0\n\n    def work(self, input_items, output_items):\n        n = len(output_items[0])\n\
      \n        # Radianes que avanza el oscilador por muestra.\n        incremento\
      \ = (\n            2 * np.pi * self.frecuencia_mezcla / self.samp_rate\n   \
      \     )\n\n        # Fases de las n muestras de este lote.\n        indices\
      \ = np.arange(n, dtype=np.float64)\n        fases = self.fase + incremento *\
      \ indices\n\n        # Exponencial compleja y multiplicaci\xF3n de las muestras.\n\
      \        oscilador = np.exp(1j * fases)\n        output_items[0][:n] = input_items[0][:n]\
      \ * oscilador\n\n        # Conservar la fase de la siguiente muestra.\n    \
      \    self.fase = (self.fase + incremento * n) % (2 * np.pi)\n\n        return\
      \ n"
    affinity: ''
    alias: ''
    comment: ''
    frecuencia_mezcla: '-57000'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: tasa_canal
  states:
    _io_cache: ('Rotador de frecuencia', 'blk', [('frecuencia_mezcla', '0.0'), ('samp_rate',
      '2400000.0')], [('0', 'complex', 1)], [('0', 'complex', 1)], 'Desplaza el espectro
      mediante una exponencial compleja.', ['frecuencia_mezcla', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 632.0]
