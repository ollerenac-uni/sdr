connections:
- [a_stream, '0', mapeador, '0']
- [cierre_rrc, '0', pulso_rrc, '0']
- [cierre_rx, '0', filtro_rx, '0']
- [decidir_bits, '0', empaquetar_bits, '0']
- [empaquetar_bits, '0', paquete_rx_a_pdu, '0']
- [epy_block_0, out, epy_block_2, in]
- [epy_block_1, out, debug_paquete_rx, print]
- [epy_block_2, out, epy_block_4, in]
- [epy_block_2, out, epy_block_5, in]
- [epy_block_3, out, epy_block_1, in]
- [epy_block_5, out, a_stream, pdus]
- [epy_block_5, out, blocks_message_debug_0, log]
- [extraer_i, '0', decidir_bits, '0']
- [filtro_rx, '0', rx_a_pdu, '0']
- [longitud_muestras, '0', muestras_a_pdu, '0']
- [longitud_rrc, '0', cierre_rx, '0']
- [longitud_rrc, '0', rrc_a_pdu, '0']
- [mapeador, '0', cierre_rrc, '0']
- [mapeador, '0', pdu_tagged_stream_to_pdu_0, '0']
- [mapeador, '0', pulso_rect, '0']
- [mensaje_a, msg, blocks_message_debug_0, print]
- [mensaje_a, msg, epy_block_0, in]
- [muestras_a_pdu, pdus, debug_muestras, print]
- [muestras_a_pdu, pdus, tiempo_bpsk, in]
- [muestrear_rx, pdu, constelacion_rx, in]
- [muestrear_rx, pdu, debug_simbolos_rx, log]
- [muestrear_rx, pdu, rx_a_stream, pdus]
- [paquete_rx_a_pdu, pdus, debug_paquete_rx, print]
- [paquete_rx_a_pdu, pdus, epy_block_3, in]
- [pdu_tagged_stream_to_pdu_0, pdus, blocks_message_debug_0, print]
- [pdu_tagged_stream_to_pdu_0, pdus, qtgui_const_sink_x_0, in]
- [pulso_rect, '0', longitud_muestras, '0']
- [pulso_rrc, '0', longitud_rrc, '0']
- [rrc_a_pdu, pdus, debug_rrc, print]
- [rrc_a_pdu, pdus, tiempo_rrc, in]
- [rrc_a_pdu, pdus, tiempo_rrc_0, in]
- [rx_a_pdu, pdus, debug_rx, print]
