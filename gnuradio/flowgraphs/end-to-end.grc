- name: snippet_0
  id: snippet
  parameters:
    alias: ''
    code: 'self.a_stream.set_min_output_buffer(0, (5000 + 6) * 8 * 2)

      self.mapeador.set_min_output_buffer(0, (5000 + 6) * 8 * 2)

      self.pulso_rect.set_min_output_buffer(0, (5000 + 6) * 8 * self.sps * 2)

      self.longitud_muestras.set_min_output_buffer(0, (5000 + 6) * 8 * self.sps *
      2)

      self.cierre_rrc.set_min_output_buffer(0, ((5000 + 6) * 8 + self.rrc_span) *
      2)

      self.pulso_rrc.set_min_output_buffer(0, ((5000 + 6) * 8 + self.rrc_span) * self.sps
      * 2)

      self.longitud_rrc.set_min_output_buffer(0, ((5000 + 6) * 8 + self.rrc_span)
      * self.sps * 2)

      self.cierre_rx.set_min_output_buffer(0, (((5000 + 6) * 8 + self.rrc_span) *
      self.sps + self.cierre_rx_muestras) * 2)

      self.filtro_rx.set_min_output_buffer(0, (((5000 + 6) * 8 + self.rrc_span) *
      self.sps + self.cierre_rx_muestras) * 2)

      self.rx_a_stream.set_min_output_buffer(0, (5000 + 6) * 8 * 2)

      self.decidir_bits.set_min_output_buffer(0, (5000 + 6) * 8 * 2)'
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 8.0]
    rotation: 0
    state: enabled
