- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self):\n        gr.basic_block.__init__(\n            self,\
      \ name=\"Texto a bytes UTF-8\", in_sig=None, out_sig=None\n        )\n\n   \
      \     self.message_port_register_in(pmt.intern(\"in\"))\n        self.message_port_register_out(pmt.intern(\"\
      out\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self.convertir)\n\n\
      \    def convertir(self, mensaje):\n        # El cuadro de texto entrega un\
      \ s\xEDmbolo PMT.\n        if not pmt.is_symbol(mensaje):\n            print(\"\
      Texto a bytes: se esperaba un mensaje de texto.\")\n            return\n\n \
      \       texto = pmt.symbol_to_string(mensaje)\n        datos = texto.encode(\"\
      utf-8\")\n\n        # PDU: metadatos vac\xEDos y vector de bytes.\n        metadatos\
      \ = pmt.make_dict()\n        vector = pmt.init_u8vector(len(datos), list(datos))\n\
      \        pdu = pmt.cons(metadatos, vector)\n\n        self.message_port_pub(pmt.intern(\"\
      out\"), pdu)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Texto a bytes UTF-8', 'blk', [], [('in', 'message', 1)], [('out',
      'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 368.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self):\n        gr.basic_block.__init__(\n            self,\
      \ name=\"Bytes a texto UTF-8\", in_sig=None, out_sig=None\n        )\n\n   \
      \     self.message_port_register_in(pmt.intern(\"in\"))\n        self.message_port_register_out(pmt.intern(\"\
      out\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self.convertir)\n\n\
      \    def convertir(self, mensaje):\n        # La entrada debe ser una PDU con\
      \ un vector de bytes.\n        if not pmt.is_pdu(mensaje) or not pmt.is_u8vector(pmt.cdr(mensaje)):\n\
      \            print(\"Bytes a texto: se esperaba una PDU de bytes.\")\n     \
      \       return\n\n        vector = pmt.cdr(mensaje)\n        datos = bytes(pmt.u8vector_elements(vector))\n\
      \n        try:\n            texto = datos.decode(\"utf-8\")\n        except\
      \ UnicodeDecodeError:\n            print(\"Bytes a texto: los bytes no forman\
      \ un texto UTF-8 v\xE1lido.\")\n            return\n\n        self.message_port_pub(pmt.intern(\"\
      out\"), pmt.intern(texto))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Bytes a texto UTF-8', 'blk', [], [('in', 'message', 1)], [('out',
      'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3632, 1792.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\nimport struct\nimport zlib\n\
      \n\nclass blk(gr.basic_block):\n    def __init__(self):\n        gr.basic_block.__init__(\n\
      \            self, name=\"Construir paquete\", in_sig=None, out_sig=None\n \
      \       )\n\n        self.message_port_register_in(pmt.intern(\"in\"))\n   \
      \     self.message_port_register_out(pmt.intern(\"out\"))\n        self.set_msg_handler(pmt.intern(\"\
      in\"), self.construir)\n\n    def construir(self, mensaje):\n        if not\
      \ pmt.is_pdu(mensaje) or not pmt.is_u8vector(pmt.cdr(mensaje)):\n          \
      \  print(\"Construir paquete: se esperaba una PDU de bytes.\")\n           \
      \ return\n\n        datos = bytes(pmt.u8vector_elements(pmt.cdr(mensaje)))\n\
      \        if len(datos) > 5000:\n            print(\"Construir paquete: el texto\
      \ supera 5000 bytes. No se env\xEDa.\")\n            return\n\n        try:\n\
      \            texto = datos.decode(\"utf-8\")\n        except UnicodeDecodeError:\n\
      \            print(\"Construir paquete: los bytes no forman un texto UTF-8 v\xE1\
      lido.\")\n            return\n\n        palabras = texto.split()\n        if\
      \ not palabras:\n            print(\"Construir paquete: mensaje vac\xEDo. No\
      \ se env\xEDa.\")\n            return\n        if len(palabras) > 500:\n   \
      \         print(\"Construir paquete: el texto supera 500 palabras. No se env\xED\
      a.\")\n            return\n\n        # La longitud cuenta solo los bytes originales\
      \ del texto.\n        cabecera = struct.pack(\"!H\", len(datos))\n        contenido\
      \ = cabecera + datos\n        crc = struct.pack(\"!I\", zlib.crc32(contenido))\n\
      \        paquete = contenido + crc\n\n        # Los metadatos siguen separados\
      \ de los bytes del paquete.\n        vector = pmt.init_u8vector(len(paquete),\
      \ list(paquete))\n        salida = pmt.cons(pmt.car(mensaje), vector)\n    \
      \    self.message_port_pub(pmt.intern(\"out\"), salida)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Construir paquete', 'blk', [], [('in', 'message', 1)], [('out', 'message',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [104, 448.0]
    rotation: 0
    state: enabled
- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\nimport struct\nimport zlib\n\
      \n\nclass blk(gr.basic_block):\n    def __init__(self):\n        gr.basic_block.__init__(\n\
      \            self, name=\"Comprobar paquete\", in_sig=None, out_sig=None\n \
      \       )\n\n        self.message_port_register_in(pmt.intern(\"in\"))\n   \
      \     self.message_port_register_out(pmt.intern(\"out\"))\n        self.set_msg_handler(pmt.intern(\"\
      in\"), self.comprobar)\n\n    def comprobar(self, mensaje):\n        if not\
      \ pmt.is_pdu(mensaje) or not pmt.is_u8vector(pmt.cdr(mensaje)):\n          \
      \  print(\"Comprobar paquete: se esperaba una PDU de bytes.\")\n           \
      \ return\n\n        paquete = bytes(pmt.u8vector_elements(pmt.cdr(mensaje)))\n\
      \n        # Primero debe haber espacio para longitud y CRC.\n        if len(paquete)\
      \ < 6:\n            print(\"Comprobar paquete: paquete demasiado corto. Se rechaza.\"\
      )\n            return\n\n        longitud = struct.unpack(\"!H\", paquete[-4:2])[0]\n\
      \        if not 1 <= longitud <= 5000:\n            print(\"Comprobar paquete:\
      \ longitud no permitida. Se rechaza.\")\n            return\n\n        if len(paquete)\
      \ != longitud + 6:\n            print(\"Comprobar paquete: el tama\xF1o no coincide.\
      \ Se rechaza.\")\n            return\n\n        crc_recibido = struct.unpack(\"\
      !I\", paquete[-4:])[0]\n        crc_calculado = zlib.crc32(paquete[:-4])\n \
      \       if crc_recibido != crc_calculado:\n            print(\"Comprobar paquete:\
      \ CRC incorrecto. Se rechaza.\")\n            return\n\n        # Solo se entregan\
      \ los bytes del texto, sin longitud ni CRC.\n        datos = paquete[2:-4]\n\
      \        vector = pmt.init_u8vector(len(datos), list(datos))\n        salida\
      \ = pmt.cons(pmt.car(mensaje), vector)\n        self.message_port_pub(pmt.intern(\"\
      out\"), salida)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Comprobar paquete', 'blk', [], [('in', 'message', 1)], [('out', 'message',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3440, 1792.0]
    rotation: 0
    state: enabled
- name: epy_block_4
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self):\n        gr.basic_block.__init__(\n            self,\
      \ name=\"Alterar segundo paquete\", in_sig=None, out_sig=None\n        )\n\n\
      \        self.contador = 0\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.message_port_register_out(pmt.intern(\"out\"))\n      \
      \  self.set_msg_handler(pmt.intern(\"in\"), self.procesar)\n\n    def procesar(self,\
      \ mensaje):\n        if not pmt.is_pdu(mensaje) or not pmt.is_u8vector(pmt.cdr(mensaje)):\n\
      \            print(\"Inyector: se esperaba una PDU de bytes.\", flush=True)\n\
      \            return\n\n        paquete = bytearray(pmt.u8vector_elements(pmt.cdr(mensaje)))\n\
      \        if len(paquete) < 7:\n            print(\"Inyector: paquete demasiado\
      \ corto.\", flush=True)\n            return\n\n        self.contador += 1\n\
      \        if self.contador == 2:\n            # \xCDndices 0 y 1: longitud. \xCD\
      ndice 2: primer byte del texto.\n            paquete[2] ^= 0x01\n          \
      \  print(\"Inyector: paquete 2, bit alterado.\", flush=True)\n        else:\n\
      \            print(f\"Inyector: paquete {self.contador}, sin cambios.\", flush=True)\n\
      \n        # Se conserva el CRC recibido; no se calcula otro CRC.\n        vector\
      \ = pmt.init_u8vector(len(paquete), list(paquete))\n        salida = pmt.cons(pmt.car(mensaje),\
      \ vector)\n        self.message_port_pub(pmt.intern(\"out\"), salida)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Alterar segundo paquete', 'blk', [], [('in', 'message', 1)], [('out',
      'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 376.0]
    rotation: 0
    state: disabled
- name: epy_block_5
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self):\n        gr.basic_block.__init__(\n            self,\
      \ name=\"Bytes a bits\", in_sig=None, out_sig=None\n        )\n\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.message_port_register_out(pmt.intern(\"out\"))\n      \
      \  self.set_msg_handler(pmt.intern(\"in\"), self.convertir)\n\n    def convertir(self,\
      \ mensaje):\n        if not pmt.is_pdu(mensaje) or not pmt.is_u8vector(pmt.cdr(mensaje)):\n\
      \            print(\"Bytes a bits: se esperaba una PDU de bytes.\", flush=True)\n\
      \            return\n\n        datos = pmt.u8vector_elements(pmt.cdr(mensaje))\n\
      \        if not datos:\n            print(\"Bytes a bits: vector vac\xEDo.\"\
      , flush=True)\n            return\n\n        bits = []\n        for byte in\
      \ datos:\n            for posicion in range(7, -1, -1):\n                bits.append((byte\
      \ >> posicion) & 1)\n\n        vector = pmt.init_u8vector(len(bits), bits)\n\
      \        salida = pmt.cons(pmt.car(mensaje), vector)\n        self.message_port_pub(pmt.intern(\"\
      out\"), salida)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Bytes a bits', 'blk', [], [('in', 'message', 1)], [('out', 'message',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [88, 536.0]
    rotation: 0
    state: enabled
